{
 "sandbox": {
  "enabled": true,
  "failIfUnavailable": true,
  "allowUnsandboxedCommands": false,
  "autoAllowBashIfSandboxed": true,
  "filesystem": {
   "denyRead": [
    "/home",
    "/home/claude",
    "/root",
    "/tmp",
    "/tmp/claude",
    "/tmp/claude-1000",
    "/tmp/repro-clone"
   ],
   "allowRead": [
    "/tmp/r2run-0o6nm_84"
   ]
  },
  "network": {
   "allowedDomains": [],
   "strictAllowlist": true
  }
 },
 "permissions": {
  "blockReadsOutsideWorkingDirectories": true,
  "deny": [
   "WebFetch",
   "WebSearch",
   "Read(//home/**)",
   "Read(//root/**)",
   "Read(//Users/**)",
   "Read(//private/tmp/**)",
   "Read(//tmp/claude/**)",
   "Read(//tmp/claude-1000/**)",
   "Read(~/**)",
   "Read(//tmp/repro-clone/**)",
   "Read(//tmp/repro-clone/**)"
  ]
 }
}